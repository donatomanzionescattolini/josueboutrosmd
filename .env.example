# ─────────────────────────────────────────────────────────────────────────────
# Contact form delivery (optional)
#
# The site builds and runs without these. Until they are set, the contact form
# returns a clear error and the UI falls back to a direct mailto link, so
# nothing silently disappears.
#
# Resend has a free tier that is more than enough for a personal site:
#   1. Sign up at https://resend.com
#   2. Add and verify josueboutrosmd.com as a sending domain
#   3. Create an API key and paste it below
#   4. Add all three values in Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# The verified sender address. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Website <website@josueboutrosmd.com>"

# Where form submissions are delivered. Defaults to `contact.email` in
# src/content/profile.ts when unset.
CONTACT_TO_EMAIL=
